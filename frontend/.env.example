# ---------------------------------------------------------------------------
# 前端环境变量示例
#
# 用法：复制成 .env.local （已被 .gitignore 忽略，不会提交），按需改值。
#   cp .env.example .env.local
#
# 说明：VITE_ 开头的变量会被打包进前端产物，任何人都能在浏览器里看到，
#      所以这里只能放地址，不能放数据库密码、后端密钥之类的东西。
# ---------------------------------------------------------------------------

# 应用标题（可留空）
VITE_APP_TITLE=绿色出行 · 碳积分

# 数据来源：
#   mock = 用本地假数据跑演示（默认，不需要后端）
#   api  = 走真实后端
VITE_DATA_SOURCE=mock

# 接口基地址（VITE_DATA_SOURCE=api 时才生效）
#   走 dev server 代理时写相对路径 /api（推荐，后端不用管 CORS）
#   直连后端时写完整地址，例如 http://localhost:8080/api
VITE_API_BASE_URL=/api

# 仅 dev server 使用：/api 代理到哪台后端（写进 vite.config.ts 的 proxy）
#   本机后端：http://localhost:8080
#   后端同学在局域网里：http://192.168.1.23:8080
VITE_PROXY_TARGET=http://localhost:8080
